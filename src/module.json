{
  "id": "dspreset",
  "name": "DSPreset",
  "abbrev": "DSR",
  "version": "0.2.0",
  "description": "Native DecentSampler DSPreset player with worker-driven disk streaming and DSLibrary import.",
  "author": "legsmechanical",
  "license": "LGPL-3.0",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": true,
    "aftertouch": true,
    "chainable": true,
    "component_type": "sound_generator",
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "DSPreset",
          "params": [
            {
              "key": "preset_path",
              "name": "Library",
              "type": "filepath",
              "root": "/data/UserData",
              "filter": [".dspreset", ".dslibrary"],
              "default": ""
            },
            {
              "key": "gain",
              "name": "Gain",
              "type": "float",
              "min": 0,
              "max": 2,
              "default": 0.7
            }
          ]
        }
      }
    }
  },
  "assets": {
    "path": "instruments",
    "label": "Sample Libraries",
    "extensions": [
      ".dspreset",
      ".dslibrary"
    ],
    "description": "Load DecentSampler DSPreset files or DSLibrary packages. DSLibrary files are unpacked and validated by a background importer before playback.",
    "hint": "DSPreset and DSLibrary only"
  },
  "defaults": {
    "gain": 0.7
  }
}
